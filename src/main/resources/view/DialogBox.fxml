<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<fx:root type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1"
         alignment="TOP_RIGHT" spacing="10.0" styleClass="dialog-box">
    <children>
        <Label fx:id="dialog" text="Label" wrapText="true" minHeight="-Infinity"
               HBox.hgrow="ALWAYS" styleClass="dialog-label" />
        <StackPane styleClass="avatar" minWidth="40.0" minHeight="40.0"
                   prefWidth="40.0" prefHeight="40.0" maxWidth="40.0" maxHeight="40.0">
            <children>
                <ImageView fx:id="avatar" fitWidth="36.0" fitHeight="36.0" preserveRatio="true" />
            </children>
        </StackPane>
    </children>
    <padding>
        <javafx.geometry.Insets bottom="5" left="5" right="5" top="5" />
    </padding>
</fx:root>
